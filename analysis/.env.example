# Copy to .env.local. Do not commit credentials.
# Optional: shared service token. Launcher generates one when omitted.
# FIREGUARD_TOKEN=
# Optional: separate H100 native-service bearer and tester-cookie signing key. Each falls back to FIREGUARD_TOKEN
# when empty; scripts/configure_modal.py generates both for Modal. Changing the cookie secret signs testers out.
FIREGUARD_NATIVE_TOKEN=
FIREGUARD_COOKIE_SECRET=
ANALYSIS_PORT=8002
CAMERA_PORT=8001
CAMERA_ID=test-camera
ANALYSIS_WS_URL=ws://127.0.0.1:8002/v1/live
# Camera policy. Empty EXPECTED_LIGHTER_CAMERAS (or *) gives a contained lighter flame low priority on every camera and
# for testers (policy id 'tester'); listing cameras restricts that downgrade to them.
# EXPECTED_LIGHTER_CAMERAS=test-camera
# HAZARDOUS_CAMERAS=warehouse-camera
