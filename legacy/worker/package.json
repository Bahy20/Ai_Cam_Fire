{
  "name": "fire-guard-worker",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ../scripts/wrangler.mjs dev --config wrangler.dev.jsonc",
    "dev:ai": "node ../scripts/wrangler.mjs dev --config wrangler.ai-dev.jsonc",
    "deploy": "node ../scripts/wrangler.mjs deploy",
    "tail": "node ../scripts/wrangler.mjs tail",
    "auth:check": "node ../scripts/wrangler.mjs whoami",
    "test": "node --test --test-concurrency=1 test/*.test.js"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
