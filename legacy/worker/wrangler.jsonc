{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "fire-guard-api",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "build": { "command": "node test/cloud-config.test.js --preflight root" },
  "secrets": { "required": ["INGEST_API_KEY"] },
  "ai": { "binding": "AI" },

  "durable_objects": {
    "bindings": [{ "name": "CAMERA_DO", "class_name": "CameraDO" }]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["CameraDO"] }
  ],

  // Pi runs CPU YOLO; the cloud coordinates trends and Workers AI enrichment.
  // The lighter-priority experiment stays disabled until its held-out and Pi gates pass.
  // Only INGEST_API_KEY is required as a secret. No external inference URLs.
  // Permanent evidence is saved on the Pi; cloud images are an inference buffer only.
  // Offline preflight does not verify or provision any remote resources.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fire-guard-db",
      "database_id": "048371ca-9b5d-485d-b09b-e2426a859ade",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "APP_ENV": "production",
    "EVIDENCE_STORAGE": "pi",
    "CAMERA_CONTEXTS_JSON": "{}",
    "OPERATOR_ACCESS_ISSUER": "",
    "OPERATOR_ACCESS_AUD": "",
    "OPERATOR_POLICY_JSON": "{}",
    "DETECTOR_PROVIDER": "edge",
    "VLM_PROVIDER": "workers_ai",
    "VLM_MODEL": "@cf/meta/llama-4-scout-17b-16e-instruct",
    "HANDHELD_PRIORITY_ENABLED": "false",
    "HANDHELD_MODEL_SHA256": "",
    "SCOUT_HANDHELD_PRIORITY_ENABLED": "false",
    "SCOUT_HANDHELD_LIVE_TEST_ENABLED": "false"
  },

  "env": {
    "production": {
      "name": "fire-guard-api",
      "build": { "command": "node test/cloud-config.test.js --preflight production" },
      "secrets": { "required": ["INGEST_API_KEY"] },
      "ai": { "binding": "AI" },
      "durable_objects": {
        "bindings": [{ "name": "CAMERA_DO", "class_name": "CameraDO" }]
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "fire-guard-db",
          "database_id": "048371ca-9b5d-485d-b09b-e2426a859ade",
          "migrations_dir": "migrations"
        }
      ],
      "vars": {
        "APP_ENV": "production",
        "EVIDENCE_STORAGE": "pi",
        "CAMERA_CONTEXTS_JSON": "{}",
        "OPERATOR_ACCESS_ISSUER": "",
        "OPERATOR_ACCESS_AUD": "",
        "OPERATOR_POLICY_JSON": "{}",
        "DETECTOR_PROVIDER": "edge",
        "VLM_PROVIDER": "workers_ai",
        "VLM_MODEL": "@cf/meta/llama-4-scout-17b-16e-instruct",
        "HANDHELD_PRIORITY_ENABLED": "false",
        "HANDHELD_MODEL_SHA256": "",
        "SCOUT_HANDHELD_PRIORITY_ENABLED": "false",
        "SCOUT_HANDHELD_LIVE_TEST_ENABLED": "false"
      }
    }
  }
}
